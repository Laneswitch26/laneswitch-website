{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laneswitch-navigator",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "laneswitch-navigator-eu",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AI_STUDIO_KV",
      "id": "58cc488df79a43d2ae3ca9bcc1a8a20e"
    }
  ]
}
