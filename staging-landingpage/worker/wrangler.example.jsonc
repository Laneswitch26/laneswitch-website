{
  "name": "laneswitch-landing-staging",
  "main": "./contact.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "directory": "../",
    "binding": "ASSETS",
    "run_worker_first": ["/api/contact"]
  },
  "vars": {
    "CONTACT_EMAIL": "kontakt@laneswitch.de",
    "CONTACT_FROM": "kontakt@laneswitch.de"
  },
  "send_email": [
    {"name": "CONTACT_EMAIL_BINDING", "destination_address": "kontakt@laneswitch.de"}
  ]
}