{
  "name": "laneswitch-assistent",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AI_ENABLED": "true",
    "FREE_PLAN_CONFIRMED": "true"
  },
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1042",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "laneswitch.online/api/assistent",
      "zone_name": "laneswitch.online"
    }
  ]
}
